# Скопируйте в .env. Секреты — только здесь/в secret storage, никогда в git и не на frontend.
APP_ENV=development
# Для docker compose DATABASE_URL задаётся в docker-compose.yml.
# Для локального запуска без Docker: см. scripts/dev_postgres.py
DATABASE_URL=postgresql+psycopg://lichnosti:lichnosti@localhost:5432/lichnosti
POSTGRES_PASSWORD=lichnosti

# В production за HTTPS обязательно true
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
CORS_ORIGINS=["http://localhost:5173"]

# LLM (OpenAI-compatible). Пусто — ИИ честно «не подключён».
# Провайдер владельца — AITUNNEL (E-028): LLM_BASE_URL=https://api.aitunnel.ru/v1, ключ из личного кабинета.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-haiku-5.5
LLM_MODEL_CHECK=gpt-6-luna-pro
LLM_MODEL_FINAL=claude-sonnet-5.5
DECISIONS_MODEL=pplx-decider-v1.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=8000

# Веб-поиск (поставщик не выбран)
SEARCH_PROVIDER=
SEARCH_API_KEY=

# MAX-бот
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru

REDIS_URL=redis://localhost:6379/0
