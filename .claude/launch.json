{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "apps/api/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "apps/api",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort",
        "--host",
        "127.0.0.1"
      ],
      "port": 5180
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "vite",
        "preview",
        "apps/web",
        "--outDir",
        "dist-demo",
        "--base",
        "/person/",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    }
  ]
}